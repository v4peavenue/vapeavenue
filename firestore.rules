rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (hasUserDoc() && getUserData().role == 'admin') ||
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && request.auth.token.email in ['v4peavenue@gmail.com', 'vanhuxley24@gmail.com', 'dutchlordsilvertongue24@gmail.com'])
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        (hasUserDoc() && getUserData().role == 'manager') ||
        ('role' in request.auth.token && request.auth.token.role == 'manager')
      );
    }

    // User profiles & account ownership
    match /users/{userId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Inventory Products (Staff update stock during POS sales; create/delete reserved for Admins/Managers)
    match /products/{productId} {
      allow read: if isSignedIn();
      allow update, create: if isSignedIn();
      allow delete: if isAdmin() || isManager();
    }

    // Sales transactions
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isManager();
    }

    // Attendance logs
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin() || isManager()
      );
      allow delete: if isAdmin() || isManager();
    }

    // Leave & Schedule Requests
    match /attendanceRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin() || isManager()
      );
    }

    // Staff Schedules
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin() || isManager()
      );
      allow delete: if isAdmin() || isManager();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isManager();
    }

    // Purchase orders
    match /purchaseOrders/{poId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || isAdmin() || isManager()
      );
      allow delete: if isAdmin() || isManager();
    }

    // Stock Adjustments
    match /stockAdjustments/{adjId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.adjustedBy == request.auth.uid || isAdmin() || isManager()
      );
      allow delete: if isAdmin() || isManager();
    }

    // Return Transactions
    match /returnTransactions/{returnId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.staffId == request.auth.uid || isAdmin() || isManager()
      );
      allow delete: if isAdmin() || isManager();
    }

    // Financial Transactions
    match /financialTransactions/{transId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || isAdmin() || isManager()
      );
      allow delete: if isSignedIn();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Brands
    match /brands/{brandId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Business Locations
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Loyalty Cards
    match /loyaltyCards/{cardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // System Invites
    match /invites/{inviteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Price Tiers
    match /priceTiers/{tierId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Promos
    match /promos/{promoId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Payment Options (Staff create/update payment methods during POS transactions)
    match /paymentOptions/{optionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isManager();
    }

    // Financial Accounts (Staff update balances when receiving sale payments)
    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isManager();
    }

    // System Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }

    // Staff Rates
    match /staffRates/{staffId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isManager();
    }
  }
}
